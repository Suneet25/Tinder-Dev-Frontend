# Full URL of the backend that `npm run dev` / `npm run preview` forward /api/* to.
# Must be a URL, not a path.
VITE_BACKEND_URL=http://localhost:7777

# Leave unset in production when the web server forwards /api to the backend
# (see README → Deploy). Set it only to call a backend on another domain
# directly; the backend must then allow this origin in cors() with
# credentials: true, and the cookie needs sameSite: "none", secure: true.
# VITE_API_URL=https://api.example.com
